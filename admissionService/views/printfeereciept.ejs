<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Head-wise fee collection</title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 9.5pt;
            margin: 0;
            padding: 0;
            line-height: 1.2;
        }

        .section-title {
            background: #e0e0e0;
            font-weight: bold;
            text-align: center;
            padding: 5px;
            margin: 10px 0 4px;
            border: 1px solid #000;
        }

        .field-item {
            border: 1px solid #000;
            padding: 4px 6px;
            min-height: 32px;
            background: #fdfdfd;
            font-size: 9.5pt;
        }

        .photo-box {
            width: 80px;
            height: 100px;
            border: 1px solid #000;
            text-align: center;
            vertical-align: middle;
        }

        .logo {
            width: 140px;
            height: auto;
        }

        .page-break {
            page-break-before: always;
        }

        .small {
            font-size: 8pt;
        }

        /* Force 4 columns when printing / PDF */
        @media print {
            .col-lg-3 {
                width: 25% !important;
                flex: 0 0 25% !important;
                max-width: 25% !important;
            }
        }

        .headwise-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: auto;
            font-size: 7pt;
        }

        .headwise-table th,
        .headwise-table td {
            border: 1px solid #000;
            padding: 3px 4px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .headwise-table thead th {
            background: #e8e8e8;
            font-weight: bold;
            text-align: center;
        }

        .headwise-table tbody td {
            text-align: right;
        }

        .headwise-table tbody td:first-child,
        .headwise-table tbody td:nth-child(2) {
            text-align: left;
        }

        .headwise-table-wrap {
            overflow-x: auto;
        }
    </style>
</head>

<body>
    <div class="section-title row">
        
        <div class="col-4">Logo</div>
        <div class="col-4">Detail of school</div>
        
        <div class="col-4">Student Photo</div>


    </div>


    <div class="row">
        <div class="col-4">Reciept No.</div>
        <div class="col-4">Session</div>
        <div class="col-4">Date</div>
    </div>
    <div class="row">
        <div class="col-4">UID NO.</div>
        <div class="col-4">Contact No</div>
        <div class="col-4">Class</div>
    </div>
    <div class="row">
        <div class="col-4">Name.</div>
    </div>
    <div class="row">
        <div class="col-4">Group Name</div>
    </div>
    </div>
    <div class="row">
        <div class="col-4">Fee Taken by</div>
    </div>

    <div class="headwise-table-wrap">
        <table class="headwise-table">
            <thead>
                <tr>
                    <th>Sr.No.</th>
                    <th>Fee Head</th>
                    <th>Month</th>
                    <th>Amount</th>


                </tr>
            </thead>
            <tbody>
                <% data?.forEach(item=>{ %>
                    <tr>
                        <td>
                            <%= item?.id %>
                        </td>
                        <td>
                            <%= item?.fee_head_name %>
                        </td>
                        <td>
                            <%= item?.month %>
                        </td>
                        <td>
                            <%= item?.amount %>
                        </td>

                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <div class="row">
            <div class="col-4">Payment Mode</div>
        </div>  
        <div class="row">
            <div class="col-4">Ref No</div>
        </div>  
        <div class="row">
            <div class="col-4">Bank</div>
        </div>  
    </div>

</body>

</html>