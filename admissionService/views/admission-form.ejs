<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Admission Form</title>

  <!-- Bootstrap 5 CDN (already in your code) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9.5pt;
      margin: 0;
      padding: 0;
      line-height: 1.2;
    }

    .section-title {
      background: #e0e0e0;
      font-weight: bold;
      text-align: center;
      padding: 5px;
      margin: 10px 0 4px;
      border: 1px solid #000;
    }

    .field-item {
      border: 1px solid #000;
      padding: 4px 6px;
      min-height: 32px;
      background: #fdfdfd;
      font-size: 9.5pt;
    }

    .photo-box {
      width: 80px;
      height: 100px;
      border: 1px solid #000;
      text-align: center;
      vertical-align: middle;
    }

    .logo {
      width: 140px;
      height: auto;
    }

    .page-break {
      page-break-before: always;
    }

    .small {
      font-size: 8pt;
    }

    /* Force 4 columns when printing / PDF */
    @media print {
      .col-lg-3 {
        width: 25% !important;
        flex: 0 0 25% !important;
        max-width: 25% !important;
      }
    }
  </style>
</head>

<body>

  <!-- Page 1 start -->

  <!-- PERSONAL INFORMATION / EDUCATION DETAIL / etc. -->

  <!-- Replace only this table part with grid -->

  <!-- Personal Information -->
  <div class="section-title">Personal Information</div>
  <div class="row g-1">
    <% const ignorePersonalFields=["id", "createdAt" , "updatedAt" ]; Object.entries(personalInformationData ||
      {}).forEach(([key, value])=> {
      if (ignorePersonalFields.includes(key)) return;
      %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          <%= key %> - <%= value ?? '' %>
        </div>
      </div>
      <% }); %>
  </div>

  <!-- Education Detail -->
  <div class="row"></div>
  <div class="section-title">Education Detail</div>
  <div class="row g-1">
    <% const ignoreEducationFields=["id", "reg_no" , "createdAt" , "updatedAt" ]; Object.entries(educationalData ||
      {}).forEach(([key, value])=> {
      if (ignoreEducationFields.includes(key)) return;
      %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          <%= key %> - <%= value ?? '' %>
        </div>
      </div>
      <% }); %>
  </div>




  <div class="section-title">Compulsory Subjects</div>
  <div class="row g-1">
    <% const compulsorySubjects=(subjectData || []) .filter(elem=> elem.elective_bbasket_id == null);

      if (compulsorySubjects.length === 0) {
      %>
      <div class="col-12">
        <div class="field-item">No compulsory subjects found</div>
      </div>
      <% } else { compulsorySubjects.forEach(elem=> {
        %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="field-item">
            <%= elem.subject?.value || '' %>
          </div>
        </div>
        <% }); } %>
  </div>


  <div class="section-title">Elective Subjects</div>
  <div class="row g-1">
    <% const electiveSubjects=(subjectData || []) .filter(elem=> elem.elective_bbasket_id != null);

      if (electiveSubjects.length === 0) {
      %>
      <div class="col-12">
        <div class="field-item">No elective subjects found</div>
      </div>
      <% } else { electiveSubjects.forEach(elem=> {
        %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="field-item">
            <%= elem.subject?.value || '' %>
          </div>
        </div>
        <% }); } %>
  </div>













  <!-- Parent particulars -->
  <div class="section-title">Parent particulars</div>
  <div class="row g-1">
    <% const ignoreParentParticularFields=["id", "reg_no" , "createdAt" , "updatedAt" ];
      Object.entries(parentparticularData || {}).forEach(([key, value])=> {
      if (ignoreParentParticularFields.includes(key)) return;
      %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          <%= key %> - <%= value ?? '' %>
        </div>
      </div>
      <% }); %>
  </div>


  <!-- transport detail-->
  <div class="section-title">Transport Detail</div>
  <div class="row g-1">
    <% if (transportData) { %>

      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          Route - <%= transportData.Route?.route_name || '' %>
        </div>
      </div>

      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          Sub Route - <%= transportData.SubRoute?.sub_route_name || '' %>
        </div>
      </div>

      <% } else { %>

        <div class="col-12">
          <div class="field-item">No transport data available</div>
        </div>

        <% } %>
  </div>


  <!-- Declaration -->
   <!-- Declaration -->
<!-- transport detail -->
<div class="section-title">Transport Detail</div>
<div class="row g-1">
  <% if (transportData) { %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="field-item">
        Route - <%= transportData.Route?.route_name || '' %>
      </div>
    </div>

    <div class="col-6 col-md-4 col-lg-3">
      <div class="field-item">
        Sub Route - <%= transportData.SubRoute?.sub_route_name || '' %>
      </div>
    </div>
  <% } else { %>
    <div class="col-12">
      <div class="field-item">No transport data available</div>
    </div>
  <% } %>
</div>

<!-- Declaration -->


<!-- Declaration -->
<!-- Declaration Heading -->
<div class="row g-1">
  <div class="col-12">
    <div class="section-title">
      Declaration
    </div>
  </div>
</div>

<!-- Declaration Content -->
<div class="row g-1 mb-2">
  <div class="col-12">
    <!-- Declaration content -->
    <div class="field-item">
      <%- declarationData?.declaration?.content || '' %>
    </div>

    <!-- Place & Date row inside the declaration block -->
    <div class="row g-1 mt-2">
      <div class="col-6">
        <div class="field-item">
          Place: <%= declarationData?.location || '' %>
        </div>
      </div>
      <div class="col-6">
        <div class="field-item">
          Date: <%= declarationData?.date ? new Date(declarationData.date).toISOString().split("T")[0] : '' %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Place and Date Row -->


  








  <!-- Other Informations -->
  <div class="section-title">Other Informations</div>
  <div class="row g-1">
    <% const ignoreOtherInfoFields=["id", "reg_no" , "createdAt" , "updatedAt" ]; Object.entries(otherInformationData ||
      {}).forEach(([key, value])=> {
      if (ignoreOtherInfoFields.includes(key)) return;
      %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="field-item">
          <%= key %> - <%= value ?? '' %>
        </div>
      </div>
      <% }); %>
  </div>

</body>

</html>